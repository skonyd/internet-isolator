#!/usr/bin/env bash
# Tether Isolator başlatıcı.
# Python paketini repo kökünden bulur ve CLI'yi çağırır.
# Kullanım:  tetherctl gui        (web arayüzü, root gerekir)
#            sudo tetherctl gui
#            tetherctl --dry-run gui --no-browser   (yetki gerekmez, test)
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export PYTHONPATH="$REPO_ROOT:${PYTHONPATH:-}"
exec python3 -m tether_isolator "$@"
