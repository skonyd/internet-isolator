[Unit]
Description=Tether Isolator daemon (izole ağ alanı + web paneli)
Documentation=file:///opt/tether-isolator/README.md
After=network.target

[Service]
Type=simple
Environment=PYTHONPATH=/opt/tether-isolator
ExecStart=/usr/bin/python3 -m tether_isolator gui --no-browser
User=root
Restart=on-failure
RestartSec=3
# Güvenlik sıkılaştırmaları (G-8)
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/tether-isolator /etc/netns
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelLogs=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Namespace işlemleri için gerekli yetenekler
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN

[Install]
WantedBy=multi-user.target
